{% comment %}
  A-line service landing hero: headline, subhead, proof stats, single CTA.
  Used by templates/page.audit.json.
{% endcomment %}

<div class="page-width section-{{ section.id }}-padding" style="padding-top: 48px; padding-bottom: 32px;">
  <div style="max-width: 760px; margin: 0 auto; text-align: center;">
    <h1 class="h0">{{ section.settings.heading }}</h1>
    {% if section.settings.subheading != blank %}
      <p style="font-size: 1.25rem; margin-top: 16px; opacity: 0.85;">{{ section.settings.subheading }}</p>
    {% endif %}
    {% if section.settings.cta_link != blank %}
      <a href="{{ section.settings.cta_link }}" class="button button--primary" style="margin-top: 24px;">
        {{ section.settings.cta_label | default: 'Book a diagnostic call' }}
      </a>
    {% endif %}
    {% if section.settings.cta_note != blank %}
      <p style="font-size: 0.85rem; margin-top: 8px; opacity: 0.6;">{{ section.settings.cta_note }}</p>
    {% endif %}
  </div>

  {% if section.blocks.size > 0 %}
    <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 40px; margin-top: 48px;">
      {% for block in section.blocks %}
        <div {{ block.shopify_attributes }} style="text-align: center; min-width: 160px;">
          <div class="h1" style="margin: 0;">{{ block.settings.value }}</div>
          <div style="opacity: 0.7;">{{ block.settings.label }}</div>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Service hero",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your AI agent is failing users. We find where, and fix it." },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Book a diagnostic call" },
    { "type": "url", "id": "cta_link", "label": "CTA link (Calendly or product page)" },
    { "type": "text", "id": "cta_note", "label": "Small note under CTA", "default": "30 minutes. We review your agent live on the call." }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Proof stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "10 days" },
        { "type": "text", "id": "label", "label": "Label", "default": "fixed-scope sprint" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Service hero" }]
}
{% endschema %}
